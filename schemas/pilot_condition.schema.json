    "model_id": {
      "enum": [
        "LR-1.9",
        "CAT-1.2",
        "XGB-3.4",
        "TPFN3-8.5",
        "TICL2-2.2"
      ],
      "title": "Model Id",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "view_id": {
      "enum": [
        "V00",
        "V01",
        "V02",
        "V03",
        "V04",
        "V05",
        "V06",
        "V07",
        "V08",
        "V09",
        "V10"
      ],
      "title": "View Id",
      "type": "string"
