          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "device_policy": {
          "enum": [
            "cpu",
            "cuda"
          ],
          "title": "Device Policy",
          "type": "string"
        },
        "metric_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metric Policy Sha256",
          "type": "string"
        },
        "model_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Config Sha256",
          "type": "string"
        },
