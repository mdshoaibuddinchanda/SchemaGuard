        "transformation_implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transformation Implementation Sha256",
          "type": "string"
        },
        "view_id": {
          "enum": [
            "V00",
            "V01",
            "V02",
            "V03",
            "V04",
            "V05",
            "V06",
            "V07",
            "V08",
            "V09",
            "V10"
          ],
          "title": "View Id",
          "type": "string"
