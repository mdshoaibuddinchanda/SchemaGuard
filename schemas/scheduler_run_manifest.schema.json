{
  "$defs": {
    "FailureRecord": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "FAIL_RESOURCE_LIMIT",
            "FAIL_TIMEOUT",
            "FAIL_CUDA_OOM",
            "FAIL_RESOURCE_MONITOR",
            "FAIL_MODEL_RUNTIME",
            "BLOCKED_GPU_UNAVAILABLE",
            "BLOCKED_INSUFFICIENT_VRAM",
            "FAIL_CACHE_INTEGRITY"
          ],
          "title": "Category",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Id",
          "type": "string"
        },
        "traceback_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceback Relative Path"
        }
      },
      "required": [
        "task_id",
        "category",
        "reason"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "ResourceRecord": {
      "additionalProperties": false,
      "properties": {
        "cleanup_passed": {
          "title": "Cleanup Passed",
          "type": "boolean"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "failure_category": {
          "anyOf": [
            {
              "enum": [
                "FAIL_RESOURCE_LIMIT",
                "FAIL_TIMEOUT",
                "FAIL_CUDA_OOM",
                "FAIL_RESOURCE_MONITOR",
                "FAIL_MODEL_RUNTIME",
                "BLOCKED_GPU_UNAVAILABLE",
                "BLOCKED_INSUFFICIENT_VRAM",
                "FAIL_CACHE_INTEGRITY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "gpu_allocated_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Allocated Mib"
        },
        "gpu_free_before_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Free Before Mib"
        },
        "gpu_reserved_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Reserved Mib"
        },
        "hard_limit_passed": {
          "title": "Hard Limit Passed",
          "type": "boolean"
        },
        "peak_process_tree_rss_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Process Tree Rss Mib"
        },
        "peak_worker_rss_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Worker Rss Mib"
        },
        "soft_limit_warning": {
          "title": "Soft Limit Warning",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "telemetry_complete": {
          "title": "Telemetry Complete",
          "type": "boolean"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "worker_pid": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Pid"
        }
      },
      "required": [
        "started_at",
        "ended_at",
        "wall_seconds",
        "timed_out",
        "soft_limit_warning",
        "hard_limit_passed",
        "cleanup_passed",
        "telemetry_complete"
      ],
      "title": "ResourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocked": {
      "minimum": 0,
      "title": "Blocked",
      "type": "integer"
    },
    "cancelled": {
      "minimum": 0,
      "title": "Cancelled",
      "type": "integer"
    },
    "executed": {
      "minimum": 0,
      "title": "Executed",
      "type": "integer"
    },
    "failed": {
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/FailureRecord"
      },
      "title": "Failures",
      "type": "array"
    },
    "max_cpu_concurrency": {
      "maximum": 2,
      "minimum": 0,
      "title": "Max Cpu Concurrency",
      "type": "integer"
    },
    "max_gpu_concurrency": {
      "maximum": 1,
      "minimum": 0,
      "title": "Max Gpu Concurrency",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "cold",
        "resume"
      ],
      "title": "Mode",
      "type": "string"
    },
    "offline_network_attempt_count": {
      "minimum": 0,
      "title": "Offline Network Attempt Count",
      "type": "integer"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "planned": {
      "minimum": 0,
      "title": "Planned",
      "type": "integer"
    },
    "recovered_abandoned": {
      "minimum": 0,
      "title": "Recovered Abandoned",
      "type": "integer"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceRecord"
      },
      "title": "Resources",
      "type": "array"
    },
    "retried": {
      "minimum": 0,
      "title": "Retried",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_implementation_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Implementation Commit",
      "type": "string"
    },
    "stage": {
      "const": "cache_scheduler_run",
      "title": "Stage",
      "type": "string"
    },
    "validated_cache_hits": {
      "minimum": 0,
      "title": "Validated Cache Hits",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "stage",
    "plan_hash",
    "source_implementation_commit",
    "mode",
    "planned",
    "executed",
    "validated_cache_hits",
    "recovered_abandoned",
    "failed",
    "blocked",
    "retried",
    "cancelled",
    "max_cpu_concurrency",
    "max_gpu_concurrency",
    "offline_network_attempt_count",
    "resources",
    "failures"
  ],
  "title": "RunManifest",
  "type": "object"
}
