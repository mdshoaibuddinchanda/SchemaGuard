{
  "$defs": {
    "SmokeCondition": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checkpoint Identifier"
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checkpoint Sha256"
        },
        "condition_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Condition Id",
          "type": "string"
        },
        "dataset_features_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Features Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ],
          "title": "Device",
          "type": "string"
        },
        "model_id": {
          "enum": [
            "LR-1.9",
            "CAT-1.2",
            "XGB-3.4",
            "TPFN3-8.5",
            "TICL2-2.2"
          ],
          "title": "Model Id",
          "type": "string"
        },
        "model_parameters": {
          "additionalProperties": true,
          "title": "Model Parameters",
          "type": "object"
        },
        "model_spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Spec Sha256",
          "type": "string"
        },
        "package_name": {
          "title": "Package Name",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "precision_policy": {
          "enum": [
            "native",
            "auto"
          ],
          "title": "Precision Policy",
          "type": "string"
        },
        "preprocessing": {
          "title": "Preprocessing",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Implementation Sha256",
          "type": "string"
        },
        "split_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Sha256",
          "type": "string"
        },
        "target_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Artifact Sha256",
          "type": "string"
        },
        "task_name": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Task Name",
          "type": "string"
        },
        "view_certificate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Certificate Sha256",
          "type": "string"
        },
        "view_features_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Features Sha256",
          "type": "string"
        },
        "view_id": {
          "enum": [
            "V00",
            "V01"
          ],
          "title": "View Id",
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "task_name",
        "model_id",
        "package_name",
        "package_version",
        "dataset_features_sha256",
        "target_artifact_sha256",
        "view_id",
        "device",
        "precision_policy",
        "seed",
        "model_spec_sha256",
        "parameters_sha256",
        "model_parameters",
        "preprocessing",
        "checkpoint_identifier",
        "checkpoint_sha256",
        "view_certificate_sha256",
        "view_features_sha256",
        "split_sha256",
        "dependency_lock_sha256",
        "source_implementation_sha256"
      ],
      "title": "SmokeCondition",
      "type": "object"
    },
    "SmokeView": {
      "additionalProperties": false,
      "properties": {
        "certificate_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Certificate Ids",
          "type": "array"
        },
        "certificate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Certificate Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Sha256"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "partition_certificate_file_sha256": {
          "additionalProperties": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "train",
              "calibration",
              "test"
            ]
          },
          "title": "Partition Certificate File Sha256",
          "type": "object"
        },
        "partition_feature_file_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "train",
              "calibration",
              "test"
            ]
          },
          "title": "Partition Feature File Sha256",
          "type": "object"
        },
        "partition_feature_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "train",
              "calibration",
              "test"
            ]
          },
          "title": "Partition Feature Sha256",
          "type": "object"
        },
        "partition_row_id_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "train",
              "calibration",
              "test"
            ]
          },
          "title": "Partition Row Id Sha256",
          "type": "object"
        },
        "partition_rows": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "train",
              "calibration",
              "test"
            ]
          },
          "title": "Partition Rows",
          "type": "object"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "view_features_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Features Sha256",
          "type": "string"
        },
        "view_id": {
          "enum": [
            "V00",
            "V01"
          ],
          "title": "View Id",
          "type": "string"
        },
        "view_name": {
          "enum": [
            "identity",
            "numeric_affine_units"
          ],
          "title": "View Name",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_name",
        "source_hash",
        "output_hash",
        "certificate_sha256",
        "certificate_ids",
        "view_features_sha256",
        "partition_feature_sha256",
        "partition_feature_file_sha256",
        "partition_certificate_file_sha256",
        "manifest_sha256",
        "partition_row_id_sha256",
        "partition_rows"
      ],
      "title": "SmokeView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignment_logical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Logical Sha256",
      "type": "string"
    },
    "assignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Sha256",
      "type": "string"
    },
    "code_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Identity Sha256",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/SmokeCondition"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Conditions",
      "type": "array"
    },
    "configuration_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Identity Sha256",
      "type": "string"
    },
    "cpu_timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Cpu Timeout Seconds",
      "type": "integer"
    },
    "cpu_workers": {
      "const": 2,
      "default": 2,
      "title": "Cpu Workers",
      "type": "integer"
    },
    "cuda_timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Cuda Timeout Seconds",
      "type": "integer"
    },
    "dataset_features_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Features Sha256",
      "type": "string"
    },
    "dataset_id": {
      "const": 1464,
      "default": 1464,
      "title": "Dataset Id",
      "type": "integer"
    },
    "dataset_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Source Sha256",
      "type": "string"
    },
    "dataset_version": {
      "const": "openml_file_1586225",
      "default": "openml_file_1586225",
      "title": "Dataset Version",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "ece_binning_rule": {
      "const": "equal_width_max_probability_confidence",
      "title": "Ece Binning Rule",
      "type": "string"
    },
    "ece_bins": {
      "maximum": 100,
      "minimum": 2,
      "title": "Ece Bins",
      "type": "integer"
    },
    "gpu_workers": {
      "const": 1,
      "default": 1,
      "title": "Gpu Workers",
      "type": "integer"
    },
    "log_loss_epsilon": {
      "exclusiveMaximum": 0.01,
      "exclusiveMinimum": 0,
      "title": "Log Loss Epsilon",
      "type": "number"
    },
    "maximum_ram_mib": {
      "exclusiveMinimum": 0,
      "maximum": 28672,
      "title": "Maximum Ram Mib",
      "type": "integer"
    },
    "maximum_vram_mib": {
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "title": "Maximum Vram Mib",
      "type": "integer"
    },
    "minimum_gpu_headroom_mib": {
      "minimum": 512,
      "title": "Minimum Gpu Headroom Mib",
      "type": "integer"
    },
    "network_enabled": {
      "const": false,
      "default": false,
      "title": "Network Enabled",
      "type": "boolean"
    },
    "output_path_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Path Policy Sha256",
      "type": "string"
    },
    "plan_name": {
      "const": "schema_guard_smoke",
      "default": "schema_guard_smoke",
      "title": "Plan Name",
      "type": "string"
    },
    "primary_metric": {
      "const": "brier_score",
      "title": "Primary Metric",
      "type": "string"
    },
    "probability_sum_tolerance": {
      "exclusiveMinimum": 0,
      "maximum": 0.0001,
      "title": "Probability Sum Tolerance",
      "type": "number"
    },
    "protocol_version": {
      "const": "schema_guard_smoke_v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "reconstruction_atol": {
      "maximum": 1e-06,
      "minimum": 0,
      "title": "Reconstruction Atol",
      "type": "number"
    },
    "reconstruction_rtol": {
      "maximum": 1e-06,
      "minimum": 0,
      "title": "Reconstruction Rtol",
      "type": "number"
    },
    "registry_parameter_decisions": {
      "items": {
        "enum": [
          "catboost_yaml_no_scalar",
          "tabicl_checkpoint_version_from_checkpoint_field"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Registry Parameter Decisions",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "const": 1729,
      "default": 1729,
      "title": "Seed",
      "type": "integer"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "split_strategy": {
      "const": "stratified_group_5fold_v1",
      "default": "stratified_group_5fold_v1",
      "title": "Split Strategy",
      "type": "string"
    },
    "target_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Artifact Sha256",
      "type": "string"
    },
    "test_label_access_boundary": {
      "const": "after_all_predictions_complete",
      "title": "Test Label Access Boundary",
      "type": "string"
    },
    "transformation_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transformation Inventory Sha256",
      "type": "string"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/SmokeView"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Views",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "source_commit",
    "code_identity_sha256",
    "dependency_lock_sha256",
    "dataset_features_sha256",
    "dataset_source_sha256",
    "target_artifact_sha256",
    "assignment_sha256",
    "assignment_logical_sha256",
    "transformation_inventory_sha256",
    "configuration_identity_sha256",
    "output_path_policy_sha256",
    "registry_parameter_decisions",
    "views",
    "conditions",
    "test_label_access_boundary",
    "primary_metric",
    "ece_binning_rule",
    "log_loss_epsilon",
    "probability_sum_tolerance",
    "reconstruction_rtol",
    "reconstruction_atol",
    "ece_bins",
    "maximum_ram_mib",
    "maximum_vram_mib",
    "minimum_gpu_headroom_mib",
    "cpu_timeout_seconds",
    "cuda_timeout_seconds"
  ],
  "title": "SmokePlan",
  "type": "object"
}
