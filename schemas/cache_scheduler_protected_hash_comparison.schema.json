{
  "$defs": {
    "ProtectedHashRecord": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "after_size_bytes": {
          "minimum": 0,
          "title": "After Size Bytes",
          "type": "integer"
        },
        "baseline_git_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Git Sha256",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "before_size_bytes": {
          "minimum": 0,
          "title": "Before Size Bytes",
          "type": "integer"
        },
        "implementation_git_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Git Sha256",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "unchanged": {
          "title": "Unchanged",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "before_sha256",
        "after_sha256",
        "baseline_git_sha256",
        "implementation_git_sha256",
        "before_size_bytes",
        "after_size_bytes",
        "unchanged"
      ],
      "title": "ProtectedHashRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Baseline Commit",
      "type": "string"
    },
    "expected_file_count": {
      "exclusiveMinimum": 0,
      "title": "Expected File Count",
      "type": "integer"
    },
    "implementation_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Implementation Commit",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ProtectedHashRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "baseline_commit",
    "implementation_commit",
    "expected_file_count",
    "records",
    "status"
  ],
  "title": "ProtectedHashComparison",
  "type": "object"
}
