{
  "additionalProperties": false,
  "description": "All causal scientific and implementation inputs for one cached artifact.",
  "properties": {
    "artifact_kind": {
      "enum": [
        "model",
        "prediction",
        "metric",
        "condition",
        "probe"
      ],
      "title": "Artifact Kind",
      "type": "string"
    },
    "checkpoint_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checkpoint Sha256"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "device_policy": {
      "enum": [
        "cpu",
        "cuda"
      ],
      "title": "Device Policy",
      "type": "string"
    },
    "model_parameters_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Parameters Sha256",
      "type": "string"
    },
    "model_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Spec Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Implementation Sha256",
      "type": "string"
    },
    "split_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Sha256",
      "type": "string"
    },
    "view_certificate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View Certificate Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_sha256",
    "split_sha256",
    "view_certificate_sha256",
    "model_spec_sha256",
    "model_parameters_sha256",
    "checkpoint_sha256",
    "dependency_lock_sha256",
    "source_implementation_sha256",
    "seed",
    "device_policy",
    "artifact_kind"
  ],
  "title": "CacheIdentity",
  "type": "object"
}
