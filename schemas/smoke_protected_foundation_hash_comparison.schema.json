    },
    "baseline_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Snapshot Sha256",
      "type": "string"
    },
    "expected_artifact_count": {
      "const": 13,
      "default": 13,
      "title": "Expected Artifact Count",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    }
