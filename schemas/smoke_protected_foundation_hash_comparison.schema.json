          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "after_size_bytes": {
          "minimum": 0,
          "title": "After Size Bytes",
          "type": "integer"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "before_size_bytes": {
          "minimum": 0,
          "title": "Before Size Bytes",
          "type": "integer"
        },
        "path": {
          "pattern": "^(data/raw|data/processed|data/splits)/[A-Za-z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        },
        "unchanged": {
          "title": "Unchanged",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "before_sha256",
        "after_sha256",
        "before_size_bytes",
        "after_size_bytes",
        "unchanged"
      ],
      "title": "ProtectedFoundationArtifactHash",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ProtectedFoundationArtifactHash"
      },
      "maxItems": 13,
      "minItems": 13,
      "title": "Artifacts",
