{
  "$defs": {
    "GpuProfileRecordContract": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Sha256"
        },
        "child_peak_ram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Peak Ram Mib"
        },
        "class_order": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Class Order",
          "type": "array"
        },
        "cycles": {
          "exclusiveMinimum": 0,
          "title": "Cycles",
          "type": "integer"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ],
          "title": "Device",
          "type": "string"
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "execution_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Policy"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "fallback_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Status"
        },
        "fit_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Seconds"
        },
        "fixture_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Hash"
        },
        "gpu_free_after_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Free After Mib"
        },
        "gpu_free_before_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Free Before Mib"
        },
        "gpu_soft_limit_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Soft Limit Mib"
        },
        "load_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Seconds"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "monitoring_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitoring Complete"
        },
        "monitoring_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitoring Error"
        },
        "oom": {
          "default": false,
          "title": "Oom",
          "type": "boolean"
        },
        "parameter_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Hash"
        },
        "peak_ram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Ram Mib"
        },
        "peak_vram_allocated_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Vram Allocated Mib"
        },
        "peak_vram_reserved_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Vram Reserved Mib"
        },
        "post_cleanup_gpu_allocated_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Cleanup Gpu Allocated Mib"
        },
        "post_cleanup_gpu_reserved_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Cleanup Gpu Reserved Mib"
        },
        "post_cleanup_ram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Cleanup Ram Mib"
        },
        "predict_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Predict Seconds",
          "type": "array"
        },
        "prediction_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Hash"
        },
        "prediction_shape": {
          "items": {
            "type": "integer"
          },
          "title": "Prediction Shape",
          "type": "array"
        },
        "probability_sum_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Sum Error"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "repeat_max_abs_diff": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Max Abs Diff"
        },
        "runtime_seconds": {
          "minimum": 0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "schema_version": {
          "minimum": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "start_time": {
          "default": "",
          "title": "Start Time",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_CPU_FALLBACK",
            "FAIL",
            "BLOCKED",
            "NOT_EXECUTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "repeated_inference_single_worker",
            "fresh_worker_per_inference",
            "cpu_fallback"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        },
        "traceback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceback"
        }
      },
      "required": [
        "schema_version",
        "model_id",
        "profile_id",
        "device",
        "strategy",
        "seed",
        "cycles",
        "status",
        "runtime_seconds",
        "prediction_shape",
        "class_order"
      ],
      "title": "GpuProfileRecordContract",
      "type": "object"
    },
    "GpuProfileSpecContract": {
      "additionalProperties": false,
      "properties": {
        "classes": {
          "minimum": 2,
          "title": "Classes",
          "type": "integer"
        },
        "predictors": {
          "exclusiveMinimum": 0,
          "title": "Predictors",
          "type": "integer"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "source_dataset_id": {
          "exclusiveMinimum": 0,
          "title": "Source Dataset Id",
          "type": "integer"
        },
        "test_rows": {
          "exclusiveMinimum": 0,
          "title": "Test Rows",
          "type": "integer"
        },
        "train_rows": {
          "exclusiveMinimum": 0,
          "title": "Train Rows",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "source_dataset_id",
        "rows",
        "predictors",
        "classes",
        "train_rows",
        "test_rows"
      ],
      "title": "GpuProfileSpecContract",
      "type": "object"
    },
    "GpuStateContract": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "capability": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "cuda_build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Build"
        },
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "free_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Mib"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "torch_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Torch Version"
        },
        "total_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Mib"
        }
      },
      "required": [
        "available"
      ],
      "title": "GpuStateContract",
      "type": "object"
    },
    "OptimizationRecordContract": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "baseline_prediction_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Prediction Hash"
        },
        "baseline_strategy": {
          "title": "Baseline Strategy",
          "type": "string"
        },
        "candidate_prediction_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Candidate Prediction Hashes",
          "type": "array"
        },
        "candidate_strategy": {
          "title": "Candidate Strategy",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prediction_equivalent": {
          "title": "Prediction Equivalent",
          "type": "boolean"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "selected_strategy": {
          "default": "fresh_worker_per_inference",
          "title": "Selected Strategy",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "model_id",
        "profile_id",
        "baseline_strategy",
        "candidate_strategy",
        "baseline_prediction_hash",
        "candidate_prediction_hashes",
        "prediction_equivalent",
        "accepted",
        "decision"
      ],
      "title": "OptimizationRecordContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounted_profiles": {
      "minimum": 0,
      "title": "Accounted Profiles",
      "type": "integer"
    },
    "checkpoint_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Checkpoint Sha256",
      "type": "object"
    },
    "fallback_policy": {
      "title": "Fallback Policy",
      "type": "string"
    },
    "foundation_models_serialized": {
      "const": true,
      "default": true,
      "title": "Foundation Models Serialized",
      "type": "boolean"
    },
    "gpu_headroom_mib": {
      "minimum": 0,
      "title": "Gpu Headroom Mib",
      "type": "number"
    },
    "gpu_soft_limit_mib": {
      "exclusiveMinimum": 0,
      "title": "Gpu Soft Limit Mib",
      "type": "number"
    },
    "gpu_state": {
      "$ref": "#/$defs/GpuStateContract"
    },
    "monitoring_complete": {
      "title": "Monitoring Complete",
      "type": "boolean"
    },
    "optimization": {
      "items": {
        "$ref": "#/$defs/OptimizationRecordContract"
      },
      "title": "Optimization",
      "type": "array"
    },
    "profile_count": {
      "minimum": 1,
      "title": "Profile Count",
      "type": "integer"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/GpuProfileSpecContract"
      },
      "title": "Profiles",
      "type": "array"
    },
    "registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Sha256",
      "type": "string"
    },
    "requested_profiles": {
      "minimum": 1,
      "title": "Requested Profiles",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/GpuProfileRecordContract"
      },
      "title": "Rows",
      "type": "array"
    },
    "runtime_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Config Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "const": "gpu_capacity",
      "default": "gpu_capacity",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "gpu_state",
    "gpu_headroom_mib",
    "gpu_soft_limit_mib",
    "profiles",
    "checkpoint_sha256",
    "registry_sha256",
    "runtime_config_sha256",
    "profile_count",
    "rows",
    "optimization",
    "fallback_policy",
    "requested_profiles",
    "accounted_profiles",
    "monitoring_complete"
  ],
  "title": "GpuCapacityReportContract",
  "type": "object"
}
